{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "destination": "https://www.fletcherwebstudio.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "destination": "https://www.fletcherwebstudio.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    }
  ]
}
